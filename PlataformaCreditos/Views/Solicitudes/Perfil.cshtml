@model PerfilClienteViewModel
@{
    ViewData["Title"] = "Perfil de cliente";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <h1 class="h3 mb-3">Crear perfil de cliente</h1>
        <p class="text-muted">Declara tus ingresos mensuales para poder solicitar créditos.</p>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <form asp-action="Perfil" method="post" class="card card-body">
            <div class="mb-3">
                <label asp-for="IngresosMensuales" class="form-label"></label>
                <input asp-for="IngresosMensuales" type="number" step="0.01" min="0.01" class="form-control" />
                <span asp-validation-for="IngresosMensuales" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary">Crear perfil</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center py-4">
    <h1 class="display-5">Plataforma de Créditos</h1>
    <p class="lead">Registra tus solicitudes de crédito y consulta su evaluación.</p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a class="btn btn-primary" asp-controller="Solicitudes" asp-action="Index">Ver mis solicitudes</a>
    }
    else
    {
        <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Login">Iniciar sesión</a>
    }
</div>
